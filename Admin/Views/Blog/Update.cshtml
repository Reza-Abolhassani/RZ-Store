@model BlogDto

@section script {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const imageInput = document.getElementById("ImageFile");
            const imagePreview = document.getElementById("imagePreview");
            const previewBox = document.getElementById("previewBox");
            const currentImageBox = document.getElementById("currentImageBox");

            if (imageInput && imagePreview && previewBox) {
                imageInput.addEventListener("change", function () {
                    const file = this.files && this.files[0];

                    if (file && file.type.startsWith("image/")) {
                        imagePreview.src = URL.createObjectURL(file);
                        previewBox.style.display = "block";

                        if (currentImageBox) {
                            currentImageBox.style.display = "none";
                        }
                    } else {
                        imagePreview.removeAttribute("src");
                        previewBox.style.display = "none";

                        if (currentImageBox) {
                            currentImageBox.style.display = "block";
                        }
                    }
                });
            }
        });
    </script>
}

<style>
    .blog-page {
        direction: rtl;
        padding: 25px 15px;
    }

    .blog-card {
        max-width: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .blog-card-header {
        padding: 20px 25px;
        border-bottom: 1px solid #eee;
    }

        .blog-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .blog-card-body {
        padding: 25px;
    }

    .blog-field {
        margin-bottom: 22px;
    }

        .blog-field label {
            display: block;
            margin-bottom: 9px;
            font-weight: 500;
            color: #555;
        }

        .blog-field .form-control {
            display: block;
            width: 100%;
            min-height: 42px;
            border: 1px solid #ddd;
            border-radius: 7px;
            padding: 9px 12px;
            box-sizing: border-box;
            background-color: #fff;
        }

        .blog-field textarea.form-control {
            min-height: 150px;
            resize: vertical;
        }

        .blog-field input[type="file"] {
            height: auto;
            background: #fafafa;
            padding: 10px;
        }

        .blog-field .form-control:focus {
            border-color: #62bd96;
            outline: none;
            box-shadow: 0 0 0 3px rgba(98, 189, 150, 0.12);
        }

    .blog-preview {
        margin-top: 15px;
    }

        .blog-preview p {
            margin-bottom: 10px;
            color: #555;
        }

        .blog-preview img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
        }

    .blog-submit {
        display: block;
        width: 100%;
        max-width: 320px;
        min-height: 44px;
        margin: 10px auto 0;
        border: none;
        border-radius: 7px;
        background: #62bd96;
        color: white;
        font-size: 15px;
        cursor: pointer;
    }

        .blog-submit:hover {
            background: #4eaa83;
        }

    .blog-field .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 13px;
    }

    .blog-cancel {
        display: block;
        margin-top: 18px;
        text-align: center;
        color: #666;
        text-decoration: none;
    }

        .blog-cancel:hover {
            color: #333;
        }

    @@media (max-width: 576px) {
        .blog-card-body {
            padding: 18px;
        }

        .blog-card-header {
            padding: 18px;
        }
    }
</style>

<div class="blog-page">
    <div class="blog-card">

        <div class="blog-card-header">
            <h3>
                <i class="icon-shield"></i>
                ویرایش مقاله
            </h3>
        </div>

        <div class="blog-card-body">

            <form asp-controller="Blog"
                  asp-action="Update"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="blog-field">
                    <label asp-for="Title">عنوان مقاله</label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="عنوان مقاله را وارد کنید" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="blog-field">
                    <label asp-for="Content">متن مقاله</label>
                    <textarea asp-for="Content"
                              class="form-control"
                              rows="5"
                              placeholder="متن مقاله را وارد کنید"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="blog-field">
                    <label asp-for="Author">نویسنده مقاله</label>
                    <input asp-for="Author"
                           class="form-control"
                           placeholder="نام نویسنده را وارد کنید" />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="blog-field">
                    <label asp-for="ImageFile">تصویر مقاله</label>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div id="currentImageBox" class="blog-preview">
                            <p>تصویر فعلی مقاله:</p>
                            <img src="@Model.ImageUrl"
                                 alt="تصویر فعلی مقاله" />
                        </div>
                    }
                    else
                    {
                        <div id="currentImageBox"
                             class="blog-preview"
                             style="display:none;">
                            <p>تصویر فعلی مقاله:</p>
                        </div>
                    }

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>

                    <div id="previewBox"
                         class="blog-preview"
                         style="display:none;">
                        <p>پیش‌نمایش تصویر جدید:</p>
                        <img id="imagePreview"
                             src=""
                             alt="پیش‌نمایش تصویر جدید مقاله" />
                    </div>
                </div>

                <div class="blog-field">
                    <label asp-for="BlogCategoryId">دسته‌بندی مقاله</label>

                    <select asp-for="BlogCategoryId" class="form-control" required>
                        <option value="">دسته‌بندی را انتخاب کنید</option>

                        @if (Model.BlogCategories != null)
                        {
                            @foreach (var item in Model.BlogCategories)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="BlogCategoryId" class="text-danger"></span>
                </div>

                <button type="submit" class="blog-submit">
                    <i class="icon-check"></i>
                    ذخیره تغییرات
                </button>

                <a asp-controller="Blog"
                   asp-action="List"
                   class="blog-cancel">
                    بازگشت به لیست مقالات
                </a>

            </form>
        </div>
    </div>
</div>