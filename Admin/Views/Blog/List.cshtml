@model List<BlogDto>

@section style {
    <!-- BEGIN PAGE CSS -->
    <link href="/assets/plugins/data-table/DataTables-1.10.16/css/jquery.dataTables.css" rel="stylesheet">
    <!-- END PAGE CSS -->
}

@section script {

    <!-- BEGIN PAGE JAVASCRIPT -->
    <script src="/assets/plugins/data-table/js/export/jquery.dataTables.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/dataTables.buttons.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/jszip.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/pdfmake.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/vfs_fonts-iransans.js"></script>
    <script src="/assets/plugins/data-table/js/export/buttons.html5.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/buttons.print.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/fa.json"></script>
    <script src="/assets/js/pages/datatable-export.js"></script>
    <!-- END PAGE JAVASCRIPT -->
}

<div class="col-lg-12">
    <div class="portlet box shadow">

        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-frane"></i>
                    جدول مقالات
                </h3>
            </div>
        </div>

        <div class="portlet-body">

            <div class="top-buttons-box mb-2">
                <a class="btn btn-success" href="/Blog/Add">
                    <i class="icon-plus"></i>
                    افزودن مقاله
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped"
                       id="data-table">

                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>تصویر</th>
                            <th>عنوان مقاله</th>
                            <th>دسته‌بندی</th>
                            <th>نویسنده</th>
                            <th>تاریخ ثبت</th>
                            <th>تاریخ ویرایش</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int i = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             width="80"
                                             height="60"
                                             style="object-fit: cover; border-radius: 5px;"
                                             alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <span>بدون تصویر</span>
                                    }
                                </td>

                                <td>@item.Title</td>

                                <td>
                                    @item.BlogCategoriesName
                                </td>

                                <td>
                                    @item.Author
                                </td>

                                <td>
                                    @item.CreationDate.ToString("yyyy/MM/dd")
                                </td>

                                <td>
                                    @item.UpdateDate.ToString("yyyy/MM/dd")
                                </td>

                                <td>
                                    <a href="/Blog/Update?id=@item.Id"
                                       class="btn btn-info">
                                        ویرایش
                                    </a>

                                    <form asp-controller="Blog"
                                          asp-action="Delete"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('آیا از حذف این مقاله مطمئن هستید؟')">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="Id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger">
                                            حذف
                                        </button>

                                    </form>
                                </td>
                            </tr>

                            i++;
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>