@model List<Admin.Models.AmazingProductsDto>

@{
    ViewData["Title"] = "محصولات شگفت انگیز";
}

<div class="container-fluid">

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5>مدیریت محصولات شگفت انگیز</h5>

            <a asp-controller="AmazingProducts"
               asp-action="Add"
               class="btn btn-success">
                افزودن محصول شگفت انگیز
            </a>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped text-center">

                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>نام محصول</th>
                            <th>قیمت اصلی</th>
                            <th>درصد تخفیف</th>
                            <th>قیمت نهایی</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int row = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@row</td>

                                    <td>@item.ProductsName</td>

                                    <td>
                                        @item.ProductsTotalPrice.ToString("N0")
                                    </td>

                                    <td>
                                        @item.DiscountPercent %
                                    </td>

                                    <td>
                                        @item.ToatalPrice.ToString("N0")
                                    </td>

                                    <td>

                                        <a asp-controller="AmazingProducts"
                                           asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="btn btn-primary btn-sm">
                                            ویرایش
                                        </a>

                                        <form asp-controller="AmazingProducts"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              style="display:inline"
                                              onsubmit="return confirm('آیا از حذف این محصول اطمینان دارید؟')">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                حذف
                                            </button>

                                        </form>

                                    </td>
                                </tr>

                                row++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    محصول شگفت انگیزی ثبت نشده است.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>