@model Admin.Models.AmazingProductsDto

@{
    ViewData["Title"] = "افزودن محصول شگفت انگیز";
}

<div class="container-fluid">

    <div class="card">

        <div class="card-header">
            <h5>افزودن محصول شگفت انگیز</h5>
        </div>

        <div class="card-body">

            <form asp-controller="AmazingProducts"
                  asp-action="Add"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="form-group mb-3">

                    <label asp-for="ProductId">
                        انتخاب محصول
                    </label>

                    <select asp-for="ProductId"
                            class="form-control"
                            required>

                        <option value="">انتخاب کنید</option>

                        @if (Model.Products != null)
                        {
                            foreach (var item in Model.Products)
                            {
                                <option value="@item.Id">
                                    @item.Title - @item.Total.ToString("N0")
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="ProductId"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group mb-3">

                    <label asp-for="DiscountPercent">
                        درصد تخفیف
                    </label>

                    <input asp-for="DiscountPercent"
                           type="number"
                           class="form-control"
                           min="0"
                           max="100"
                           placeholder="درصد تخفیف را وارد کنید"
                           required />

                    <span asp-validation-for="DiscountPercent"
                          class="text-danger">
                    </span>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">
                        ثبت محصول
                    </button>

                    <a asp-controller="AmazingProducts"
                       asp-action="List"
                       class="btn btn-secondary">
                        بازگشت
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

