@model BlogCategoryDto

<style>
    .category-page {
        direction: rtl;
        padding: 25px 15px;
    }

    .category-card {
        max-width: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .category-card-header {
        padding: 20px 25px;
        border-bottom: 1px solid #eee;
    }

        .category-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .category-card-body {
        padding: 25px;
    }

    .category-field {
        margin-bottom: 22px;
    }

        .category-field label {
            display: block;
            margin-bottom: 9px;
            font-weight: 500;
            color: #555;
        }

        .category-field .form-control {
            width: 100%;
            min-height: 42px;
            border: 1px solid #ddd;
            border-radius: 7px;
            padding: 9px 12px;
            box-sizing: border-box;
        }

    .category-submit {
        display: block;
        width: 100%;
        max-width: 320px;
        min-height: 44px;
        margin: 10px auto 0;
        border: none;
        border-radius: 7px;
        background: #62bd96;
        color: white;
        font-size: 15px;
        cursor: pointer;
    }

        .category-submit:hover {
            background: #4eaa83;
        }

    @@media (max-width: 576px) {
        .category-card-body {
            padding: 18px;
        }

        .category-card-header {
            padding: 18px;
        }
    }
</style>

<div class="category-page">
    <div class="category-card">

        <div class="category-card-header">
            <h3>
                <i class="icon-shield"></i>
                ویرایش دسته‌بندی مقالات
            </h3>
        </div>

        <div class="category-card-body">

            <form asp-controller="BlogCategory"
                  asp-action="Update"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All"
                     class="text-danger">
                </div>

                <div class="category-field">
                    <label asp-for="Name">نام دسته‌بندی</label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="نام دسته‌بندی را وارد کنید" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="category-submit">
                    <i class="icon-check"></i>
                    ذخیره تغییرات
                </button>

                <a href="/BlogCategory/List"
                   class="btn btn-secondary"
                   style="display:block; width:100%; max-width:320px; margin:12px auto 0; text-align:center;">
                    بازگشت به لیست
                </a>

            </form>

        </div>
    </div>
</div>