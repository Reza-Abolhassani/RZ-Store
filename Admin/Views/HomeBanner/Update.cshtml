@model Admin.Models.EditHomeBannerDto

@section script {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const imageInput = document.getElementById("ImageFile");
            const imagePreview = document.getElementById("imagePreview");
            const previewBox = document.getElementById("previewBox");
            const currentImageBox = document.getElementById("currentImageBox");

            if (!imageInput) return;

            imageInput.addEventListener("change", function () {
                const file = this.files && this.files[0];

                if (file && file.type.startsWith("image/")) {
                    imagePreview.src = URL.createObjectURL(file);
                    previewBox.style.display = "block";

                    if (currentImageBox) {
                        currentImageBox.style.display = "none";
                    }
                } else {
                    imagePreview.src = "";
                    previewBox.style.display = "none";

                    if (currentImageBox) {
                        currentImageBox.style.display = "block";
                    }
                }
            });
        });
    </script>
}

<style>
    .category-page {
        direction: rtl;
        padding: 25px 15px;
    }

    .category-card {
        max-width: 760px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,.10);
        overflow: hidden;
    }

    .category-card-header {
        padding: 20px 25px;
        border-bottom: 1px solid #eee;
    }

        .category-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .category-card-body {
        padding: 25px;
    }

    .category-field {
        margin-bottom: 22px;
    }

        .category-field label {
            display: block;
            margin-bottom: 9px;
            font-weight: 500;
            color: #555;
        }

        .category-field .form-control {
            width: 100%;
            min-height: 42px;
            border: 1px solid #ddd;
            border-radius: 7px;
            padding: 9px 12px;
            box-sizing: border-box;
        }

    .category-preview {
        margin-top: 15px;
    }

        .category-preview img {
            width: 180px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
        }

    .category-submit {
        display: block;
        width: 100%;
        max-width: 320px;
        min-height: 44px;
        margin: 10px auto 0;
        border: none;
        border-radius: 7px;
        background: #62bd96;
        color: white;
        font-size: 15px;
        cursor: pointer;
    }

        .category-submit:hover {
            background: #4eaa83;
        }

    @@media (max-width: 576px) {
        .category-card-body {
            padding: 18px;
        }

        .category-card-header {
            padding: 18px;
        }
    }
</style>

<div class="category-page">
    <div class="category-card">

        <div class="category-card-header">
            <h3>ویرایش بنر صفحه اصلی</h3>
        </div>

        <div class="category-card-body">

            <form asp-controller="HomeBanner"
                  asp-action="Update"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="category-field">
                    <label asp-for="Title">عنوان بنر</label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="عنوان بنر را وارد کنید" />
                </div>

                <div class="category-field">
                    <label asp-for="Description">توضیحات بنر</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="توضیحات بنر را وارد کنید"></textarea>
                </div>

                <div class="category-field">
                    <label asp-for="ButtonText">متن دکمه</label>
                    <input asp-for="ButtonText"
                           class="form-control" />
                </div>

                <div class="category-field">
                    <label asp-for="Link">لینک دکمه</label>
                    <input asp-for="Link"
                           class="form-control" />
                </div>

                <div class="category-field">
                    <label asp-for="Position">محل نمایش بنر</label>
                    <select asp-for="Position" class="form-control">
                        <option value="1">بالای صفحه اصلی</option>
                        <option value="2">پایین صفحه اصلی</option>
                    </select>
                </div>

                <div class="category-field">
                    <label asp-for="Order">ترتیب نمایش</label>
                    <input asp-for="Order"
                           type="number"
                           class="form-control" />
                </div>

                <div class="category-field">
                    <label asp-for="IsActive">وضعیت بنر</label>
                    <div>
                        <input asp-for="IsActive" type="checkbox" />
                        فعال بودن بنر
                    </div>
                </div>

                <div class="category-field">
                    <label asp-for="ImageFile">تصویر بنر</label>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <div id="currentImageBox" class="category-preview">
                            <p>تصویر فعلی بنر:</p>
                            <img src="@Model.ImageUrl" alt="تصویر فعلی بنر" />
                        </div>
                    }
                    else
                    {
                        <div id="currentImageBox"
                             class="category-preview"
                             style="display:none;">
                            <p>تصویر فعلی بنر:</p>
                        </div>
                    }

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <div id="previewBox"
                         class="category-preview"
                         style="display:none;">
                        <p>پیش‌نمایش تصویر جدید:</p>
                        <img id="imagePreview" src="" alt="پیش‌نمایش تصویر جدید" />
                    </div>
                </div>

                <button type="submit" class="category-submit">
                    ذخیره تغییرات
                </button>

            </form>

        </div>
    </div>
</div>