@model List<UserDto>

@section style {

    <!-- BEGIN PAGE CSS -->
    <link href="/assets/plugins/data-table/DataTables-1.10.16/css/jquery.dataTables.css" rel="stylesheet">
    <!-- END PAGE CSS -->

    <style>
        .user-action-btn {
            width: 115px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 3px 2px;
            font-size: 13px;
            white-space: nowrap;
        }
    </style>
}

@section script {

    <!-- BEGIN PAGE JAVASCRIPT -->
    <script src="/assets/plugins/data-table/js/export/jquery.dataTables.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/dataTables.buttons.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/jszip.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/pdfmake.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/vfs_fonts-iransans.js"></script>
    <script src="/assets/plugins/data-table/js/export/buttons.html5.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/buttons.print.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/fa.json"></script>
    <script src="/assets/js/pages/datatable-export.js"></script>
    <!-- END PAGE JAVASCRIPT -->
}

<div class="col-lg-12">
    <div class="portlet box shadow">

        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-user"></i>
                    لیست کاربران
                </h3>
            </div>
        </div>

        <div class="portlet-body">

            <div class="top-buttons-box mb-2">
                <a class="btn btn-success" href="/User/Add">
                    <i class="icon-plus"></i>
                    افزودن کاربر
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped" id="data-table">

                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>تصویر</th>
                            <th>نام و نام خانوادگی</th>
                            <th>نام کاربری</th>
                            <th>شماره موبایل</th>
                            <th>ایمیل</th>
                            <th>نقش کاربر</th>
                            <th>وضعیت</th>
                            <th>تاریخ ثبت‌نام</th>
                            <th>آخرین ورود</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int i = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>

                                <td>
                                    <img src="@item.ImageUrl"
                                         width="60"
                                         height="60"
                                         style="object-fit:cover; border-radius:50%;" />
                                </td>

                                <td>
                                    @item.FirstName @item.LastName
                                </td>

                                <td>@item.UserName</td>

                                <td>@item.PhoneNumber</td>

                                <td>@item.Email</td>

                                <td>@item.Role</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">
                                            فعال
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">
                                            غیرفعال
                                        </span>
                                    }
                                </td>

                                <td>
                                    @item.RegisterDate.ToString("yyyy/MM/dd")
                                </td>

                                <td>
                                    <!--چرا تاریخ آخرین ورود را با علامت سؤال نوشتیم؟-->
                                    @(item.LastLoginDate?.ToString("yyyy/MM/dd") ?? "ندارد")
                                </td>
                                <!--چون LastLoginDate از نوع Nullable است و ممکن است کاربر هنوز وارد سایت نشده باشد.-->

                                <td>
                                    <a href="/User/Update?id=@item.Id"
                                       class="btn btn-info user-action-btn">
                                        ویرایش
                                    </a>

                                    <a href="/User/WalletCharge?UserId=@item.Id"
                                       class="btn btn-success user-action-btn">
                                        شارژ کیف پول
                                    </a>

                                    <a href="/User/TransactionList?UserId=@item.Id"
                                       class="btn btn-warning user-action-btn">
                                        تراکنش‌ها
                                    </a>

                                    <form action="/User/Delete"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('آیا از حذف این کاربر مطمئن هستید؟')">

                                        <input type="hidden" name="id" value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger user-action-btn">
                                            حذف
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            i++;
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>