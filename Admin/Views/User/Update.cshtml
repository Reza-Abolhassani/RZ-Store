@model UserDto

@section script {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // پیش‌نمایش تصویر جدید کاربر
            const imageInput = document.getElementById("ImageFile");
            const imagePreview = document.getElementById("imagePreview");

            if (imageInput && imagePreview) {
                imageInput.addEventListener("change", function () {

                    const file = this.files[0];

                    if (file && file.type.startsWith("image/")) {
                        imagePreview.src = URL.createObjectURL(file);
                    }
                });
            }

        });
    </script>
}

<style>
    .category-page {
        direction: rtl;
        padding: 25px 15px;
    }

    .category-card {
        max-width: 510px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .category-card-header {
        padding: 20px 25px;
        border-bottom: 1px solid #eee;
    }

        .category-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .category-card-body {
        padding: 25px;
    }

    .category-field {
        margin-bottom: 22px;
    }

        .category-field label {
            display: block;
            margin-bottom: 9px;
            font-weight: 500;
            color: #555;
        }

        .category-field .form-control {
            display: block;
            width: 100%;
            min-height: 42px;
            border: 1px solid #ddd;
            border-radius: 7px;
            padding: 9px 12px;
            box-sizing: border-box;
            background: #fff;
        }

        .category-field input[type="file"] {
            height: auto;
            background: #fafafa;
            padding: 10px;
            position: static;
            opacity: 1;
        }

    .category-preview {
        margin-top: 15px;
    }

        .category-preview img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
        }

    .category-submit {
        display: block;
        width: 100%;
        max-width: 215px;
        min-height: 44px;
        margin: 10px auto 0;
        border: none;
        border-radius: 7px;
        background: #62bd96;
        color: white;
        font-size: 15px;
        cursor: pointer;
    }

        .category-submit:hover {
            background: #4eaa83;
        }

    @@media (max-width: 576px) {
        .category-card-body {
            padding: 18px;
        }

        .category-card-header {
            padding: 18px;
        }
    }
</style>

<div class="category-page">
    <div class="category-card">

        <div class="category-card-header">
            <h3>
                <i class="icon-user"></i>
                ویرایش اطلاعات کاربر
            </h3>
        </div>

        <div class="category-card-body">

            <form asp-controller="User"
                  asp-action="Update"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="category-field">
                    <label asp-for="FirstName">نام</label>
                    <input asp-for="FirstName"
                           class="form-control"
                           placeholder="نام کاربر را وارد کنید" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="category-field">
                    <label asp-for="LastName">نام خانوادگی</label>
                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="نام خانوادگی را وارد کنید" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="category-field">
                    <label asp-for="UserName">نام کاربری</label>
                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="نام کاربری را وارد کنید" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="category-field">
                    <label asp-for="PhoneNumber">شماره موبایل</label>
                    <input asp-for="PhoneNumber"
                           type="tel"
                           class="form-control"
                           placeholder="شماره موبایل را وارد کنید" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="category-field">
                    <label asp-for="Email">ایمیل</label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="ایمیل را وارد کنید" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="category-field">
                    <label asp-for="Role">نقش کاربر</label>

                    <select asp-for="Role"
                            class="form-control"
                            asp-items="Html.GetEnumSelectList<Entities.Constants.SystemRoles>()">
                    </select>

                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="category-field">
                    <label>
                        <input asp-for="IsActive" type="checkbox" />
                        حساب کاربر فعال باشد
                    </label>
                </div>

                <div class="category-field">
                    <label>تصویر فعلی کاربر</label>

                    <div class="category-preview">
                        <img id="imagePreview"
                             src="@Model.ImageUrl"
                             alt="تصویر کاربر" />
                    </div>
                </div>

                <div class="category-field">
                    <label asp-for="ImageFile">انتخاب تصویر جدید</label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <button type="submit" class="category-submit">
                    <i class="icon-check"></i>
                    ذخیره تغییرات
                </button>

            </form>

        </div>
    </div>
</div>