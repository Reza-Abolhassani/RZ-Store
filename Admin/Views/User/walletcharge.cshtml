@model UserWalletDto

<style>
    .category-page {
        direction: rtl;
        padding: 25px 15px;
    }

    .category-card {
        max-width: 510px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.10);
        overflow: hidden;
    }

    .category-card-header {
        padding: 20px 25px;
        border-bottom: 1px solid #eee;
    }

        .category-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .category-card-body {
        padding: 25px;
    }

    .category-field {
        margin-bottom: 22px;
    }

        .category-field label {
            display: block;
            margin-bottom: 9px;
            font-weight: 500;
            color: #555;
        }

        .category-field .form-control {
            display: block;
            width: 100%;
            min-height: 42px;
            border: 1px solid #ddd;
            border-radius: 7px;
            padding: 9px 12px;
            box-sizing: border-box;
            background: #fff;
        }

    .category-submit {
        display: block;
        width: 100%;
        max-width: 215px;
        min-height: 44px;
        margin: 10px auto 0;
        border: none;
        border-radius: 7px;
        background: #62bd96;
        color: white;
        font-size: 15px;
        cursor: pointer;
    }

        .category-submit:hover {
            background: #4eaa83;
        }

    @@media (max-width: 576px) {
        .category-card-body {
            padding: 18px;
        }

        .category-card-header {
            padding: 18px;
        }
    }
</style>

<div class="category-page">
    <div class="category-card">

        <div class="category-card-header">
            <h3>
                <i class="icon-wallet"></i>
                شارژ کیف پول کاربر
            </h3>
        </div>

        <div class="category-card-body">

            <form asp-controller="User"
                  asp-action="walletcharge"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="category-field">
                    <label>مبلغ شارژ یا کسر از کیف پول (تومان)</label>

                    <input asp-for="Amount"
                           type="number"
                           class="form-control"
                           placeholder="مبلغ مورد نظر را وارد کنید" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>

                    <small class="text-muted">
                        مبلغ مثبت برای شارژ و مبلغ منفی برای کسر از کیف پول است.
                    </small>
                </div>

                <button type="submit" class="category-submit">
                    <i class="icon-check"></i>
                    ثبت عملیات
                </button>

                <a href="/User/List"
                   class="btn btn-default"
                   style="display:block; text-align:center; margin-top:15px;">
                    بازگشت به لیست کاربران
                </a>

            </form>

        </div>
    </div>
</div>