@model ChangePasswordDto

<!-- BEGIN BREADCRUMB -->
<div class="col-md-12">
    <div class="breadcrumb-box shadow">
        <ul class="breadcrumb">
            <li><a href="dashboard.html">پیشخوان</a></li>
            <li><a href="#">صفحات</a></li>
            <li class="active">تغییر رمز عبور</li>
        </ul>
        <div class="breadcrumb-left">
            شنبه، 1403/09/10
            <i class="icon-calendar"></i>
        </div><!-- /.breadcrumb-left -->
    </div><!-- /.breadcrumb-box -->
</div><!-- /.col-md-12 -->
<!-- END BREADCRUMB -->

<div class="col-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-lock"></i>
                    تغییر رمز عبور
                </h3>
            </div><!-- /.portlet-title -->

        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="alert alert-info">
                <i class="icon-bell"></i>
                استفاده از کاراکترهای خاص جهت حفظ موارد امنیتی توصیه می گردد. همچنین رمز ورودی باید دست کم 6 کاراکتر باشد.
            </div><!-- /.alert -->
            <div class="row">
                <div class="col-lg-4 offset-lg-4 col-md-8 offset-md-2 shadow p-b-30">
                    <p class="text-center m-t-40 m-b-40">
                        <i class="icon-lock border img-circle text-primary font-xxxlg p-20"></i>
                    </p>
                    <hr>
                    <form id="form" role="form" method="POST">
                        <div class="form-body">
                            <div class="form-group">
                                <label for="oldPassword">رمز عبور پیشین</label>
                                <div class="input-group has-btn-toggle-pass">
                                    <span class="input-group-addon">
                                        <i class="icon-lock"></i>
                                    </span>
                                    <input type="password" asp-for="CurrentPassword" minlength="6" class="form-control ltr text-left" required>
                                    <span class="btn-toggle-pass">
                                        <i class="icon-eye"></i>
                                    </span>
                                </div><!-- /.input-group -->
                            </div><!-- /.form-group -->
                            <div class="form-group">
                                <label for="password">رمز عبور جدید</label>
                                <div class="input-group has-btn-toggle-pass">
                                    <span class="input-group-addon">
                                        <i class="icon-key"></i>
                                    </span>
                                    <input type="password" asp-for="NewPassword" minlength="6" class="form-control ltr text-left" required>
                                    <span class="btn-toggle-pass">
                                        <i class="icon-eye"></i>
                                    </span>
                                </div><!-- /.input-group -->
                            </div><!-- /.form-group -->
                            <div class="form-group">
                                <label for="confirmPassword">رمز عبور</label>
                                <div class="input-group has-btn-toggle-pass">
                                    <span class="input-group-addon">
                                        <i class="icon-key"></i>
                                    </span>
                                    <input type="password" asp-for="ConfirmPassword" minlength="6" class="form-control ltr text-left" required>
                                    <span class="btn-toggle-pass">
                                        <i class="icon-eye"></i>
                                    </span>
                                </div><!-- /.input-group -->
                            </div><!-- /.form-group -->
                        </div><!-- /.form-body -->
                        <div class="form-actions">
                            <button type="submit" class="btn btn-success btn-round">
                                <i class="icon-check"></i>
                                ثبت
                            </button>

                        </div><!-- /.form-actions -->
                    </form>
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-12 -->
