@model List<CategoryDto>

@section style {
    <link href="/assets/plugins/data-table/DataTables-1.10.16/css/jquery.dataTables.css" rel="stylesheet">

    <style>
        .category-image {
            width: 80px;
            height: 80px;
            object-fit: contain;
            border-radius: 8px;
            background: #f8f8f8;
        }

        .category-title {
            white-space: nowrap;
            display: inline-block;
        }

        .main-category {
            font-weight: bold;
        }

        .sub-category {
            color: #2196F3;
        }
    </style>
}

@section script {
    <script src="/assets/plugins/data-table/js/export/jquery.dataTables.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/dataTables.buttons.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/jszip.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/pdfmake.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/vfs_fonts-iransans.js"></script>
    <script src="/assets/plugins/data-table/js/export/buttons.html5.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/buttons.print.min.js"></script>
    <script src="/assets/plugins/data-table/js/export/fa.json"></script>
    <script src="/assets/js/pages/datatable-export.js"></script>
}

<div class="col-lg-12">
    <div class="portlet box shadow">

        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-frane"></i>
                    جدول دسته بندی
                </h3>
            </div>
        </div>

        <div class="portlet-body">

            <div class="top-buttons-box mb-2">
                <a class="btn btn-success" href="/Category/Add">
                    <i class="icon-plus"></i>
                    افزودن دسته بندی
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped" id="data-table">

                    <thead>
                        <tr>
                            <th>ردیف</th>
                            <th>تصویر</th>
                            <th>نام</th>
                            <th>دسته والد</th>
                            <th>ترتیب</th>
                            <th>توضیحات</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int i = 1;

                            void RenderCategories(List<CategoryDto> categories, int level)
                            {
                                foreach (var item in categories)
                                {
                                    <tr>
                                        <td>@i</td>

                                        <td>
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Title"
                                                 class="category-image" />
                                        </td>

                                        <td>
                                            <span class="category-title"
                                                  style="padding-right: @(level * 25)px;">

                                                @if (level == 0)
                                                {
                                                    <span>📁 </span>
                                                }
                                                else
                                                {
                                                    <span class="sub-category">↳ </span>
                                                }

                                                @item.Title
                                            </span>
                                        </td>

                                        <td>
                                            @item.ParentTitle
                                        </td>

                                        <td>@item.Order</td>

                                        <td>@item.Description</td>

                                        <td>
                                            <a href="/Category/Update?id=@item.Id"
                                               class="btn btn-info">
                                                ویرایش
                                            </a>

                                            <a href="/Category/Delete?id=@item.Id"
                                               class="btn btn-danger"
                                               onclick="return confirm('آیا از حذف این دسته‌بندی مطمئن هستید؟')">
                                                حذف
                                            </a>
                                        </td>
                                    </tr>

                                    i++;

                                    if (item.Children != null && item.Children.Any())
                                    {
                                        RenderCategories(item.Children, level + 1);
                                    }
                                }
                            }

                            RenderCategories(Model, 0);
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>