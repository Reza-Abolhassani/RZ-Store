@model Admin.Models.StoreSettingsDto

@section script {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const selectLogoBtn = document.getElementById("selectLogoBtn");
            const logoFile = document.getElementById("LogoFile");
            const fileName = document.getElementById("fileName");

            selectLogoBtn.addEventListener("click", function () {
                logoFile.click();
            });

            logoFile.addEventListener("change", function () {
                fileName.textContent = this.files.length > 0
                    ? this.files[0].name
                    : "فایلی انتخاب نشده است";
            });

        });
    </script>
}

<div class="col-lg-12">
    <div class="portlet box shadow">

        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-settings"></i>
                    تنظیمات فروشگاه
                </h3>
            </div>
        </div>

        <div class="portlet-body">

            <form asp-controller="StoreSettings"
                  asp-action="Index"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="SiteName">نام فروشگاه</label>
                        <input asp-for="SiteName" class="form-control" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="PhoneNumber">شماره تماس</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Email">ایمیل</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Address">آدرس فروشگاه</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Instagram">آدرس اینستاگرام</label>
                        <input asp-for="Instagram" class="form-control" />
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="Telegram">آدرس تلگرام</label>
                        <input asp-for="Telegram" class="form-control" />
                    </div>

                    <div class="col-md-12 form-group mb-3">
                        <label asp-for="Description">توضیحات فروشگاه</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"></textarea>
                    </div>

                    <div class="col-md-12 form-group mb-3">

                        <label class="d-block">لوگوی فروشگاه</label>

                        

                        @if (!string.IsNullOrEmpty(Model.Logo))
                        {
                            <div class="mb-3">
                                <img src="@Model.Logo"
                                     alt="لوگوی فروشگاه"
                                     style="width:150px; height:150px; object-fit:contain; border:1px solid #ddd; padding:5px;" />
                            </div>
                        }

                        <input asp-for="LogoFile"
                               type="file"
                               accept="image/*"
                               style="display:none;" />

                        <button type="button"
                                class="btn btn-info"
                                id="selectLogoBtn">
                            <i class="icon-picture"></i>
                            انتخاب تصویر جدید
                        </button>

                        <span id="fileName" class="mr-2">
                            فایلی انتخاب نشده است
                        </span>

                    </div>

                </div>

                <div class="text-left mt-3">
                    <button type="submit" class="btn btn-success">
                        <i class="icon-check"></i>
                        ذخیره تنظیمات
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>