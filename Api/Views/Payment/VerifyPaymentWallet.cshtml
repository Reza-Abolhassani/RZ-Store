@* @using API.Models.Payments
@{
    Layout = null;
}
@model PaymentLogDto
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>پرداخت موفق | شارژ کیف پول</title>

    <!-- فونت فارسی (می‌تونی حذفش کنی یا لوکال جایگزین کنی) -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #0E0F10; /* پس‌زمینه‌ی تیره ملایم */
            --card: #111315; /* کارت تیره */
            --soft: #1A1D20; /* مرز/سایه نرم */
            --primary: #163E35; /* سبز تیره الهام از طرح‌ات */
            --primary-2: #1E5B4D;
            --success: #1BBB77; /* سبز موفقیت */
            --text: #E7ECEF; /* متن اصلی */
            --muted: #9BA4AB; /* متن فرعی */
            --pill: #192B26; /* بک‌گراند چیپ‌ها */
            --border: #202428;
            --radius: 18px;
            --radius-sm: 12px;
            --shadow: 0 12px 30px rgba(0,0,0,.35);
        }

        * {
            box-sizing: border-box
        }

        html, body {
            height: 100%
        }

        body {
            margin: 0;
            background: radial-gradient(1200px 700px at 50% -10%, #13201C 0%, #0F1315 45%, var(--bg) 100%);
            color: var(--text);
            font-family: Vazirmatn, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .wrap {
            width: 100%;
            max-width: 460px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            opacity: .9;
            font-weight: 800;
            letter-spacing: .2px;
        }

        .brand-logo {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            background: linear-gradient(145deg, var(--primary), var(--primary-2));
            box-shadow: inset 0 0 0 2px rgba(255,255,255,.06);
            position: relative;
            overflow: hidden;
        }

            .brand-logo::after {
                content: "";
                position: absolute;
                inset: -1px;
                background: radial-gradient(140px 140px at 120% -10%, rgba(255,255,255,.08), transparent 60%), radial-gradient(140px 140px at -10% 120%, rgba(255,255,255,.06), transparent 60%);
                mix-blend-mode: screen;
                pointer-events: none;
            }

        .card {
            background: linear-gradient(180deg, var(--card), #0F1113 100%);
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        /* هدر موفقیت */
        .hero {
            padding: 28px 24px 12px;
            position: relative;
            border-bottom: 1px solid var(--border);
        }

        .check {
            width: 82px;
            height: 82px;
            margin: 0 auto 14px;
            border-radius: 22px;
            background: radial-gradient(80px 80px at 30% 20%, #1f6b5a 0%, #17493D 65%, #133C33 100%);
            display: grid;
            place-items: center;
            box-shadow: inset 0 0 0 2px rgba(255,255,255,.06), 0 12px 30px rgba(7, 128, 96, .25);
            position: relative;
            overflow: hidden;
            animation: pop .5s ease-out both;
        }

            .check svg {
                width: 40px;
                height: 40px;
            }

            .check .ring {
                position: absolute;
                inset: -10px;
                border-radius: 30px;
                background: radial-gradient(120px 120px at 50% 50%, rgba(255,255,255,.06), transparent 60%);
                filter: blur(8px);
                opacity: .65;
                animation: ring 2.6s ease-in-out infinite;
            }

        @@keyframes pop {
            0% {
                transform: scale(.8);
                opacity: .0
            }

            100% {
                transform: scale(1);
                opacity: 1
            }
        }

        @@keyframes ring {
            0%, 100% {
                transform: rotate(0deg) scale(1)
            }

            50% {
                transform: rotate(6deg) scale(1.02)
            }
        }

        .hero h1 {
            margin: 0 0 6px;
            text-align: center;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: .2px;
        }

        .hero p {
            margin: 0;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }

        /* مبلغ و چیپ‌ها */
        .amount {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 20px 8px;
            flex-wrap: wrap;
        }

        .price {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: .3px;
            background: linear-gradient(180deg, #EAF6F1, #D3F1E6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 0 rgba(0,0,0,0); /* برای سافاری */
        }

        .chip {
            font-size: 11px;
            color: #B7C3C9;
            background: var(--pill);
            border: 1px dashed #2A3834;
            padding: 6px 10px;
            border-radius: 999px;
        }

        /* جزئیات */
        .section {
            padding: 16px 18px;
        }

        .box {
            border: 1px solid var(--border);
            background: linear-gradient(180deg, #101315, #0E1113);
            border-radius: var(--radius-sm);
            padding: 14px;
        }

            .box + .box {
                margin-top: 10px
            }

        .row {
            display: grid;
            grid-template-columns: 110px 1fr;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px dashed #1f2428;
            align-items: center;
        }

            .row:last-child {
                border-bottom: none
            }

        .lbl {
            color: #8FA5A6;
            font-size: 12px
        }

        .val {
            color: #E9F3F0;
            font-weight: 600;
            font-size: 14px;
            letter-spacing: .2px
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #202529, transparent);
            margin: 12px 0;
        }

        .receipt {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 10px;
            align-items: center;
            background: linear-gradient(180deg, #0F1413, #0E1112);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 12px 14px;
        }

            .receipt small {
                color: #8FA5A6
            }

        /* دکمه‌ها */
        .actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 14px 18px 18px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 46px;
            border-radius: 12px;
            padding: 0 14px;
            text-decoration: none;
            font-weight: 800;
            letter-spacing: .2px;
            transition: transform .12s ease, box-shadow .12s ease, background .2s ease;
            border: 1px solid var(--border);
        }

            .btn:active {
                transform: translateY(1px)
            }

        .btn-primary {
            background: linear-gradient(180deg, var(--primary-2), var(--primary));
            color: #E7FFF5;
            box-shadow: 0 10px 22px rgba(12, 93, 72, .35);
        }

        .btn-ghost {
            background: #131719;
            color: #D8E6E2
        }

        .btn-outline {
            background: transparent;
            color: #D8E6E2
        }

        .safe-note {
            text-align: center;
            color: #7FA395;
            font-size: 12px;
            padding: 4px 0 16px;
        }

        /* ریسپانسیو */
        @@media (max-width:420px) {
            .row {
                grid-template-columns: 95px 1fr
            }
        }
    </style>
</head>
<body>

    <main class="wrap">
        <div class="brand">
            <div class="brand-logo" aria-hidden="true">
                <!-- می‌تونی لوگوی خودت رو اینجا جایگزین کنی -->
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                    <path d="M4 7.5c0-1.7 0-2.6.34-3.27a3 3 0 0 1 1.89-1.59C7 2.4 8 2.4 9.9 2.4h4.2c1.9 0 2.85 0 3.67.24a3 3 0 0 1 1.89 1.59c.34.67.34 1.57.34 3.27v9c0 1.7 0 2.6-.34 3.27a3 3 0 0 1-1.89 1.59c-.82.24-1.77.24-3.67.24H9.9c-1.9 0-2.85 0-3.67-.24a3 3 0 0 1-1.89-1.59C4 19.1 4 18.2 4 16.5v-9Z" stroke="rgba(255,255,255,.12)" />
                </svg>
            </div>
            رزرو نوبت
        </div>

        <article class="card" role="status" aria-live="polite">
            <header class="hero">
                <div class="check" aria-hidden="true">
                    <div class="ring"></div>
                    <svg viewBox="0 0 24 24" stroke="white" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </div>
                <h1>پرداخت با موفقیت انجام شد</h1>
                <p>شارژ کیف پول انجام شد و پیامک تأیید ارسال گردید.</p>
            </header>

            <div class="amount">
                <div class="price">@Model.TotalPrice.ToString("N0") تومان</div>
                <span class="chip">درگاه: زرین پال</span>
            </div>

            <section class="section">
                <div class="box">
                    <div class="row">
                        <div class="lbl">نام شما</div>
                        <div class="val">@Model.PatientUserFirstName @Model.PatientUserLastName </div>
                    </div>

                    <div class="row">
                        <div class="lbl">کد رهگیری بانک</div>
                        <div class="val" dir="ltr">@Model.RefId</div>
                    </div>

                </div>

                <div class="box">
                    <div class="row">
                        <div class="lbl">مبلغ شارژ</div>
                        <div class="val">@Model.TotalPrice.ToString("N0") تومان</div>
                    </div>
                </div>
            </section>

            <p class="safe-note">در صورت بروز مشکل با پشتیبانی تماس بگیرید: ۹۱۰۰۱۲۳۴-۰۲۱</p>

            <div class="actions">
                <a class="btn btn-outline" href="goljaamapp://wallet?status=success">بازگشت به خانه</a>
                <a class="btn btn-outline" href="goljaamapp://wallet?status=failed">بازگشت نا موفق تست</a>
                <a class="btn btn-ghost" href="#">پشتیبانی</a>
            </div>
        </article>
    </main>

</body>
</html>
 *@