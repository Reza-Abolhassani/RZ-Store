{
  "ConnectionStrings": {
    "SqlServer": "Server=.;Database=BaseProjDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Elmah": "Server=.;Database=BaseProjDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "SiteSettings": {
    "ElmahPath": "/elmah-errors",
    "JwtSettings": {
      "SecretKey": "CHANGE_ME_WITH_A_SECURE_32_CHAR_SECRET",
      "EncryptKey": "CHANGE_ME_16_KEY",
      "Issuer": "goljaam",
      "Audience": "goljaam",
      "NotBeforeMinutes": 0,
      "ExpirationMinutes": 1440,
      "RequireHttpsMetadata": false
    },
    "IdentitySettings": {
      "PasswordRequireDigit": true,
      "PasswordRequiredLength": 6,
      "PasswordRequireNonAlphanumeric": false,
      "PasswordRequireUppercase": false,
      "PasswordRequireLowercase": false,
      "RequireUniqueEmail": true
    },
    "GoogleSettings": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "CorsSettings": {
      "AllowedOrigins": []
    },
    "DatabaseSettings": {
      "AutoMigrate": true
    },
    "DataSeedSettings": {
      "SeedDefaultRoles": true,
      "SeedDemoUsers": true,
      "AdminUserName": "admin",
      "AdminEmail": "admin@b.com",
      "AdminPassword": "123456",
      "ClientUserName": "Client",
      "ClientEmail": "Client@b.com",
      "ClientPassword": "123456"
    },
    "SmsSettings": {
      "BaseUrl": "https://console.melipayamak.com",
      "ApiToken": "",
      "OtpPath": "api/send/otp/{token}",
      "SharedPath": "api/send/shared/{token}"
    }
  }
}
