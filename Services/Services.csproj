<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <Nullable>enable</Nullable>

  </PropertyGroup>

  <ItemGroup>
    <None Remove="DataInitializer\Data\cities-filtered.json" />
    <None Remove="DataInitializer\Data\provinces.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="DataInitializer\Data\cities-filtered.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
