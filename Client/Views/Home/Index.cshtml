<!-- Start -->
<section class="section">
    <!-- Start پربازدیدترین محصولات -->
    <!-- <div class="container"> -->
    <div style="background:#fff; border:1px solid #e9ecef; border-radius:24px; padding:25px;">
        <div class="row">
            <div class="col-12">
                <h5 class="mb-0">جدیدترین محصولات</h5>
            </div><!--end col-->
        </div><!--end row-->

        <div class="row">

            @foreach(var item in Model.NewProducts)
            {
                <div class="col-lg-3 col-md-6 col-12 mt-4 pt-2">
                <div class="card shop-list border-0 position-relative">
                    <ul class="label list-unstyled mb-0">

                        <li><a href="javascript:void(0)" class="badge badge-link rounded-pill bg-primary">جدید </a></li>
                        
                    </ul>
                    <div class="shop-image position-relative overflow-hidden rounded shadow">
                            <a asp-controller="Product"
                               asp-action="ProductDetail"
                               asp-route-Id="@item.Id">
                                <img src="@item.ImageUrl" class="img-fluid" alt="@item.Title">
                            </a>
                            <a asp-controller="Product"
                               asp-action="ProductDetail"
                               asp-route-Id="@item.Id"
                               class="overlay-work">
                                <img src="@item.ImageUrl" class="img-fluid" alt="@item.Title">
                        </a>
                        <ul class="list-unstyled shop-icons">
                            <li><a href="javascript:void(0)" class="btn btn-icon btn-pills btn-soft-danger"><i data-feather="heart" class="icons"></i></a></li>
                            <li class="mt-2"><a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#productview" class="btn btn-icon btn-pills btn-soft-primary"><i data-feather="eye" class="icons"></i></a></li>
                            <li class="mt-2"><a href="shop-cart.html" class="btn btn-icon btn-pills btn-soft-warning"><i data-feather="shopping-cart" class="icons"></i></a></li>
                        </ul>
                    </div>
                    <div class="card-body content pt-4 p-2">
                            <a asp-controller="Product"
                               asp-action="ProductDetail"
                               asp-route-Id="@item.Id"
                               class="text-dark product-name h6">
                                @item.Title
                            </a>
                        <div class="d-flex justify-content-between mt-1">
                                <h6 class="text-muted small fst-italic mb-0 mt-1">

                                    @item.Total تومان

                                    @if (item.Discount > 0)
                                    {
                                        <del class="text-danger ms-2">
                                            @item.RawPrice تومان
                                        </del>
                                    }

                                </h6>
                            
                        </div>
                    </div>
                </div>
            </div><!--end col-->
                
            }

            
        </div><!--end row-->
    </div><!--end container-->
