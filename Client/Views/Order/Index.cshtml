@model List<Client.Models.OrderDto>

@{
    ViewData["Title"] = "سفارش‌های من";
}

<div class="container mt-4 mb-5" style="padding-top: 200px;">

    <h4 class="mb-4">سفارش‌های من</h4>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            هنوز هیچ سفارشی ثبت نکرده‌اید.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center">

                <thead class="table-light">
                    <tr>
                        <th>کد سفارش</th>
                        <th>تاریخ ثبت</th>
                        <th>مبلغ سفارش</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Code</td>

                            <td>
                                @item.CreationDateTime
                            </td>

                            <td>
                                @item.Total.ToString("N0") تومان
                            </td>

                            <td>
                                @item.Status
                            </td>

                            <td>
                                <a asp-controller="Order"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">
                                    جزئیات
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>