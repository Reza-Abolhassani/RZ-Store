@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ثبت نام";
}

<div class="container-fluid">
    <div class="row min-vh-100 align-items-center">

        <!-- بخش تصویر -->
        <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center bg-light">
            <div class="text-center p-5">
                <img src="~/images/user/signup.svg"
                     class="img-fluid"
                     alt="Register"
                     style="max-height: 450px;" />

                <h4 class="mt-4">به R & Z خوش آمدید</h4>

                <p class="text-muted">
                    حساب کاربری خود را بسازید و خرید آسان‌تری را تجربه کنید.
                </p>
            </div>
        </div>

        <!-- بخش فرم ثبت نام -->
        <div class="col-lg-6">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-9 col-lg-8">

                        <div class="text-center mb-4">
                            <h3>ایجاد حساب کاربری</h3>
                            <p class="text-muted">
                                اطلاعات خود را برای ثبت نام وارد کنید.
                            </p>
                        </div>

                        <!-- پیام -->
                        <div id="registerMessage"
                             class="alert d-none"
                             role="alert">
                        </div>

                        <form id="registerForm"
                              asp-controller="Auth"
                              asp-action="Register"
                              method="post">

                            @Html.AntiForgeryToken()

                            <!-- نام -->
                            <div class="mb-3">
                                <label for="FirstName" class="form-label">
                                    نام
                                </label>

                                <input type="text"
                                       name="FirstName"
                                       id="FirstName"
                                       class="form-control"
                                       placeholder="نام خود را وارد کنید"
                                       maxlength="50"
                                       required />
                            </div>

                            <!-- نام خانوادگی -->
                            <div class="mb-3">
                                <label for="LastName" class="form-label">
                                    نام خانوادگی
                                </label>

                                <input type="text"
                                       name="LastName"
                                       id="LastName"
                                       class="form-control"
                                       placeholder="نام خانوادگی خود را وارد کنید"
                                       maxlength="50"
                                       required />
                            </div>

                            <!-- شماره موبایل -->
                            <div class="mb-3">
                                <label for="PhoneNumber" class="form-label">
                                    شماره موبایل
                                </label>

                                <input type="tel"
                                       name="PhoneNumber"
                                       id="PhoneNumber"
                                       class="form-control"
                                       placeholder="09123456789"
                                       maxlength="11"
                                       pattern="09[0-9]{9}"
                                       autocomplete="off"
                                       required />
                            </div>
                            <!--ایمیل-->
                            <div class="mb-3">
                                <label class="form-label">آدرس ایمیل</label>
                                <input type="email"
                                       name="Email"
                                       id="Email"
                                       class="form-control"
                                       placeholder="example@gmail.com"
                                       autocomplete="email"
                                       required />
                            </div>

                            <!-- رمز عبور -->
                            <div class="mb-3">
                                <label for="Password" class="form-label">
                                    رمز عبور
                                </label>

                                <input type="password"
                                       name="Password"
                                       id="Password"
                                       class="form-control"
                                       placeholder="حداقل 12 کاراکتر"
                                       minlength="8"
                                       maxlength="100"
                                       required />
                            </div>

                            <!-- تکرار رمز عبور -->
                            <div class="mb-3">
                                <label for="ConfirmPassword" class="form-label">
                                    تکرار رمز عبور
                                </label>

                                <input type="password"
                                       name="ConfirmPassword"
                                       id="ConfirmPassword"
                                       class="form-control"
                                       placeholder="رمز عبور را مجدداً وارد کنید"
                                       required />
                            </div>

                            <!-- دکمه ثبت نام -->
                            <div class="d-grid mt-4">
                                <button type="submit"
                                        id="registerButton"
                                        class="btn btn-primary">
                                    ثبت نام
                                </button>
                            </div>

                        </form>

                        <!-- لینک ورود -->
                        <div class="text-center mt-4">
                            <p class="text-muted">
                                قبلاً ثبت نام کرده‌اید؟
                                <a asp-controller="Auth"
                                   asp-action="Login"
                                   class="text-primary fw-bold">
                                    وارد شوید
                                </a>
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {

    <script>
        const registerForm = document.getElementById("registerForm");
        const registerButton = document.getElementById("registerButton");
        const registerMessage = document.getElementById("registerMessage");

        registerForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            registerMessage.className = "alert d-none";
            registerMessage.innerText = "";

            const password = document.getElementById("Password").value;
            const confirmPassword = document.getElementById("ConfirmPassword").value;

            // بررسی برابر بودن رمز عبور
            if (password !== confirmPassword) {
                showMessage("رمز عبور و تکرار آن یکسان نیستند.", false);
                return;
            }

            registerButton.disabled = true;
            registerButton.innerText = "در حال ثبت نام...";

            try {
                const formData = new FormData(registerForm);

                const response = await fetch(registerForm.action, {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (result.succeeded) {
                    showMessage(result.message, true);

                    if (result.redirectUrl) {
                        setTimeout(() => {
                            window.location.href = result.redirectUrl;
                        }, 1000);
                    }
                }
                else {
                    showMessage(result.message || "ثبت نام انجام نشد.", false);
                }
            }
            catch (error) {
                showMessage("ارتباط با سرور برقرار نشد.", false);
            }
            finally {
                registerButton.disabled = false;
                registerButton.innerText = "ثبت نام";
            }
        });

        function showMessage(message, success) {
            registerMessage.className = success
                ? "alert alert-success"
                : "alert alert-danger";

            registerMessage.innerText = message;
        }
    </script>
}