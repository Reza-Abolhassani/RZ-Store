@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "فراموشی رمز عبور";
}

<section class="bg-home d-table w-100">
    <div class="container">
        <div class="row align-items-center">

            <!-- تصویر سمت چپ -->
            <div class="col-lg-7 col-md-6">
                <div class="me-lg-5">
                    <img src="/images/user/login.svg"
                         class="img-fluid d-block mx-auto"
                         alt="بازیابی رمز عبور فروشگاه R & Z" />
                </div>
            </div>

            <!-- فرم بازیابی رمز عبور -->
            <div class="col-lg-5 col-md-6">
                <div class="card shadow rounded border-0">
                    <div class="card-body p-4">

                        <div class="text-center mb-4">
                            <h3 class="fw-bold">R & Z</h3>

                            <h5 class="card-title mt-3">
                                فراموشی رمز عبور
                            </h5>

                            <p class="text-muted">
                                برای بازیابی رمز عبور، شماره موبایل خود را وارد کنید.
                            </p>
                        </div>

                        <form id="forgotPasswordForm">

                            @Html.AntiForgeryToken()

                            <!-- شماره موبایل -->
                            <div class="mb-3">
                                <label class="form-label">
                                    شماره موبایل
                                </label>

                                <div class="form-icon position-relative">
                                    <i data-feather="smartphone"
                                       class="fea icon-sm icons"></i>

                                    <input type="tel"
                                           id="PhoneNumber"
                                           name="PhoneNumber"
                                           class="form-control ps-5"
                                           placeholder="09123456789"
                                           maxlength="11"
                                           pattern="09[0-9]{9}"
                                           required />
                                </div>
                            </div>

                            <!-- درخواست کد تأیید -->
                            <div class="d-grid mb-3">
                                <button type="button"
                                        id="requestOtpButton"
                                        class="btn btn-primary">
                                    دریافت کد تأیید
                                </button>
                            </div>

                            <!-- بخش رمز عبور جدید -->
                            <div id="resetPasswordSection" style="display:none;">

                                <hr class="my-4" />

                                <div class="mb-3">
                                    <label class="form-label">
                                        کد تأیید
                                    </label>

                                    <div class="form-icon position-relative">
                                        <i data-feather="key"
                                           class="fea icon-sm icons"></i>

                                        <input type="text"
                                               id="Code"
                                               name="Code"
                                               class="form-control ps-5"
                                               placeholder="کد شش رقمی"
                                               maxlength="6"
                                               pattern="[0-9]{6}"
                                               inputmode="numeric"
                                               required />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        رمز عبور جدید
                                    </label>

                                    <div class="form-icon position-relative">
                                        <i data-feather="lock"
                                           class="fea icon-sm icons"></i>

                                        <input type="password"
                                               id="Password"
                                               name="Password"
                                               class="form-control ps-5"
                                               placeholder="حداقل ۸ کاراکتر"
                                               minlength="8"
                                               required />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        تکرار رمز عبور جدید
                                    </label>

                                    <div class="form-icon position-relative">
                                        <i data-feather="lock"
                                           class="fea icon-sm icons"></i>

                                        <input type="password"
                                               id="ConfirmPassword"
                                               name="ConfirmPassword"
                                               class="form-control ps-5"
                                               placeholder="رمز عبور را دوباره وارد کنید"
                                               minlength="8"
                                               required />
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button type="submit"
                                            id="resetPasswordButton"
                                            class="btn btn-success">
                                        تغییر رمز عبور
                                    </button>
                                </div>

                            </div>

                        </form>

                        <!-- پیام سیستم -->
                        <div id="authMessage" class="mt-3"></div>

                        <!-- بازگشت به ورود -->
                        <div class="text-center mt-4">
                            <a asp-controller="Auth"
                               asp-action="Login"
                               class="text-primary fw-bold">
                                بازگشت به صفحه ورود
                            </a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {

    <script>

        // آدرس اکشن‌ها
        const requestOtpUrl =
            '@Url.Action("RequestPasswordResetOtp", "Auth")';

        const resetPasswordUrl =
            '@Url.Action("ResetPassword", "Auth")';

        // دریافت توکن ضد جعل درخواست
        function getAntiforgeryToken(form) {

            return form.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;
        }

        // نمایش پیام
        function showMessage(message, success) {

            const box = document.getElementById("authMessage");

            box.className = success
                ? "alert alert-success mt-3"
                : "alert alert-danger mt-3";

            box.textContent = message;
        }

        // دریافت کد تأیید
        document.getElementById("requestOtpButton")
            .addEventListener("click", async function () {

                const form =
                    document.getElementById("forgotPasswordForm");

                const phoneNumber =
                    document.getElementById("PhoneNumber").value.trim();

                const button = this;

                if (!/^09\d{9}$/.test(phoneNumber)) {

                    showMessage("شماره موبایل معتبر نیست.", false);

                    return;
                }

                button.disabled = true;

                try {

                    const response = await fetch(requestOtpUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": getAntiforgeryToken(form)
                        },

                        body: new URLSearchParams({
                            PhoneNumber: phoneNumber
                        })

                    });

                    const result = await response.json();

                    showMessage(result.message, result.succeeded);

                    if (result.succeeded) {

                        document.getElementById("resetPasswordSection")
                            .style.display = "block";

                    }

                }
                catch {

                    showMessage("خطا در ارتباط با سرور.", false);

                }
                finally {

                    button.disabled = false;

                }

            });

        // تغییر رمز عبور
        document.getElementById("forgotPasswordForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const form = this;

                const button =
                    document.getElementById("resetPasswordButton");

                const phoneNumber =
                    document.getElementById("PhoneNumber").value.trim();

                const password =
                    document.getElementById("Password").value;

                const confirmPassword =
                    document.getElementById("ConfirmPassword").value;

                if (password !== confirmPassword) {

                    showMessage("رمز عبور و تکرار آن یکسان نیستند.", false);

                    return;
                }

                button.disabled = true;

                const data = new URLSearchParams({

                    PhoneNumber: phoneNumber,

                    Code:
                        document.getElementById("Code").value.trim(),

                    Password: password,

                    ConfirmPassword: confirmPassword

                });

                try {

                    const response = await fetch(resetPasswordUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": getAntiforgeryToken(form)
                        },

                        body: data

                    });

                    const result = await response.json();

                    showMessage(result.message, result.succeeded);

                    if (result.succeeded && result.redirectUrl) {

                        setTimeout(function () {

                            window.location.href = result.redirectUrl;

                        }, 1500);

                    }

                }
                catch {

                    showMessage("خطا در ارتباط با سرور.", false);

                }
                finally {

                    button.disabled = false;

                }

            });

    </script>
}