@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "ورود به حساب کاربری";
}

<section class="bg-home d-table w-100">
    <div class="container">
        <div class="row align-items-center">

            <!-- تصویر سمت چپ -->
            <div class="col-lg-7 col-md-6">
                <div class="me-lg-5">
                    <img src="/images/user/login.svg"
                         class="img-fluid d-block mx-auto"
                         alt="ورود به فروشگاه R & Z" />
                </div>
            </div>

            <!-- فرم ورود سمت راست -->
            <div class="col-lg-5 col-md-6">
                <div class="card shadow rounded border-0">
                    <div class="card-body p-4">

                        <!-- عنوان -->
                        <div class="text-center mb-4">
                            <h3 class="fw-bold">R & Z</h3>

                            <h5 class="card-title mt-3">
                                ورود به حساب کاربری
                            </h5>

                            <p class="text-muted">
                                روش ورود خود را انتخاب کنید.
                            </p>
                        </div>

                        <!-- تب های ورود -->
                        <div class="row g-2 mb-4">

                            <div class="col-6">
                                <button type="button"
                                        id="otpTab"
                                        class="btn btn-primary w-100">
                                    <i data-feather="smartphone"
                                       class="fea icon-sm me-1"></i>
                                    ورود با پیامک
                                </button>
                            </div>

                            <div class="col-6">
                                <button type="button"
                                        id="passwordTab"
                                        class="btn btn-outline-primary w-100">
                                    <i data-feather="lock"
                                       class="fea icon-sm me-1"></i>
                                    ورود با رمز
                                </button>
                            </div>

                        </div>

                        <!-- ========================= -->
                        <!-- ورود با کد پیامکی -->
                        <!-- ========================= -->

                        <div id="otpLoginSection">

                            <form id="requestOtpForm">

                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label class="form-label">
                                        شماره موبایل
                                    </label>

                                    <div class="form-icon position-relative">
                                        <i data-feather="smartphone"
                                           class="fea icon-sm icons"></i>

                                        <input type="tel"
                                               id="PhoneNumber"
                                               name="PhoneNumber"
                                               class="form-control ps-5"
                                               placeholder="09123456789"
                                               maxlength="11"
                                               required />
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button type="submit"
                                            id="requestOtpButton"
                                            class="btn btn-primary">
                                        دریافت کد تأیید
                                    </button>
                                </div>

                            </form>

                            <!-- بخش تأیید کد -->
                            <div id="otpSection"
                                 class="mt-4"
                                 style="display:none;">

                                <div class="alert alert-info">
                                    کد تأیید شش‌رقمی را وارد کنید.
                                </div>

                                <form id="verifyOtpForm">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           id="VerifyPhoneNumber"
                                           name="PhoneNumber" />

                                    <div class="mb-3">
                                        <label class="form-label">
                                            کد تأیید
                                        </label>

                                        <input type="text"
                                               id="Code"
                                               name="Code"
                                               class="form-control"
                                               maxlength="6"
                                               placeholder="کد شش‌رقمی"
                                               required />
                                    </div>

                                    <div id="newUserFields">

                                        <div class="mb-3">
                                            <label class="form-label">
                                                نام
                                            </label>

                                            <input type="text"
                                                   id="FirstName"
                                                   name="FirstName"
                                                   class="form-control"
                                                   maxlength="50"
                                                   placeholder="نام شما" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                نام خانوادگی
                                            </label>

                                            <input type="text"
                                                   id="LastName"
                                                   name="LastName"
                                                   class="form-control"
                                                   maxlength="50"
                                                   placeholder="نام خانوادگی شما" />
                                        </div>

                                        <small class="text-muted">
                                            کاربران جدید باید نام و نام خانوادگی خود را وارد کنند.
                                        </small>

                                    </div>

                                    <div class="d-grid mt-3">
                                        <button type="submit"
                                                id="verifyOtpButton"
                                                class="btn btn-success">
                                            تأیید و ورود
                                        </button>
                                    </div>

                                </form>
                            </div>

                        </div>

                        <!-- ========================= -->
                        <!-- ورود با رمز عبور -->
                        <!-- ========================= -->

                        <div id="passwordLoginSection"
                             style="display:none;">

                            <form id="passwordLoginForm">

                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label class="form-label">
                                        شماره موبایل
                                    </label>

                                    <div class="form-icon position-relative">
                                        <i data-feather="smartphone"
                                           class="fea icon-sm icons"></i>

                                        <input type="tel"
                                               id="LoginUserName"
                                               name="UserName"
                                               class="form-control ps-5"
                                               placeholder="09123456789"
                                               maxlength="11"
                                               required />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">
                                        رمز عبور
                                    </label>

                                    <div class="form-icon position-relative">
                                        <i data-feather="lock"
                                           class="fea icon-sm icons"></i>

                                        <input type="password"
                                               id="LoginPassword"
                                               name="Password"
                                               class="form-control ps-5"
                                               placeholder="رمز عبور خود را وارد کنید"
                                               required />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="RememberMe"
                                               name="RememberMe"
                                               value="true" />

                                        <label class="form-check-label"
                                               for="RememberMe">
                                            مرا به خاطر بسپار
                                        </label>
                                    </div>
                                </div>

                                <div class="d-grid">
                                    <button type="submit"
                                            id="passwordLoginButton"
                                            class="btn btn-primary">
                                        ورود به حساب کاربری
                                    </button>
                                </div>

                            </form>

                        </div>

                        <!-- پیام های سیستم -->
                        <div id="authMessage" class="mt-3"></div>

                        <!-- ثبت نام -->
                        <div class="text-center mt-4">
                            <p class="mb-0 text-muted">
                                حساب کاربری ندارید؟

                                <a asp-controller="Auth"
                                   asp-action="Register"
                                   class="text-primary fw-bold">
                                    ثبت‌نام کنید
                                </a>
                            </p>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {

    <script>

        // آدرس اکشن ها
        const requestOtpUrl = '@Url.Action("RequestOtp", "Auth")';
        const verifyOtpUrl = '@Url.Action("VerifyOtp", "Auth")';
        const passwordLoginUrl = '@Url.Action("PasswordLogin", "Auth")';

        // عناصر صفحه
        const otpTab = document.getElementById("otpTab");
        const passwordTab = document.getElementById("passwordTab");

        const otpLoginSection = document.getElementById("otpLoginSection");
        const passwordLoginSection = document.getElementById("passwordLoginSection");

        // تغییر تب ورود
        otpTab.addEventListener("click", function () {

            otpLoginSection.style.display = "block";
            passwordLoginSection.style.display = "none";

            otpTab.classList.remove("btn-outline-primary");
            otpTab.classList.add("btn-primary");

            passwordTab.classList.remove("btn-primary");
            passwordTab.classList.add("btn-outline-primary");

            document.getElementById("authMessage").innerHTML = "";
        });

        passwordTab.addEventListener("click", function () {

            otpLoginSection.style.display = "none";
            passwordLoginSection.style.display = "block";

            passwordTab.classList.remove("btn-outline-primary");
            passwordTab.classList.add("btn-primary");

            otpTab.classList.remove("btn-primary");
            otpTab.classList.add("btn-outline-primary");

            document.getElementById("authMessage").innerHTML = "";
        });

        // دریافت توکن ضد جعل درخواست
        function getAntiforgeryToken(form) {

            return form.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;
        }

        // نمایش پیام
        function showMessage(message, success) {

            const box = document.getElementById("authMessage");

            box.className = success
                ? "alert alert-success mt-3"
                : "alert alert-danger mt-3";

            box.textContent = message;
        }

        // =========================
        // درخواست کد پیامکی
        // =========================

        document.getElementById("requestOtpForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const form = this;

                const phoneNumber =
                    document.getElementById("PhoneNumber").value.trim();

                const button =
                    document.getElementById("requestOtpButton");

                button.disabled = true;

                try {

                    const response = await fetch(requestOtpUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": getAntiforgeryToken(form)
                        },

                        body: new URLSearchParams({
                            PhoneNumber: phoneNumber
                        })

                    });

                    const result = await response.json();

                    showMessage(result.message, result.succeeded);

                    if (result.succeeded) {

                        document.getElementById("VerifyPhoneNumber").value =
                            phoneNumber;

                        document.getElementById("otpSection").style.display =
                            "block";
                    }

                }
                catch {

                    showMessage("خطا در ارتباط با سرور.", false);

                }
                finally {

                    button.disabled = false;

                }

            });

        // =========================
        // تأیید کد پیامکی
        // =========================

        document.getElementById("verifyOtpForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const form = this;

                const button =
                    document.getElementById("verifyOtpButton");

                button.disabled = true;

                const data = new URLSearchParams({

                    PhoneNumber:
                        document.getElementById("VerifyPhoneNumber").value,

                    Code:
                        document.getElementById("Code").value,

                    FirstName:
                        document.getElementById("FirstName").value,

                    LastName:
                        document.getElementById("LastName").value

                });

                try {

                    const response = await fetch(verifyOtpUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": getAntiforgeryToken(form)
                        },

                        body: data

                    });

                    const result = await response.json();

                    showMessage(result.message, result.succeeded);

                    if (result.succeeded && result.redirectUrl) {

                        window.location.href = result.redirectUrl;

                    }

                }
                catch {

                    showMessage("خطا در ارتباط با سرور.", false);

                }
                finally {

                    button.disabled = false;

                }

            });

        // =========================
        // ورود با رمز عبور
        // =========================

        document.getElementById("passwordLoginForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const form = this;

                const button =
                    document.getElementById("passwordLoginButton");

                button.disabled = true;

                const data = new URLSearchParams({

                    UserName:
                        document.getElementById("LoginUserName").value.trim(),

                    Password:
                        document.getElementById("LoginPassword").value,

                    RememberMe:
                        document.getElementById("RememberMe").checked

                });

                try {

                    const response = await fetch(passwordLoginUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": getAntiforgeryToken(form)
                        },

                        body: data

                    });

                    const result = await response.json();

                    showMessage(result.message, result.succeeded);

                    if (result.succeeded && result.redirectUrl) {

                        window.location.href = result.redirectUrl;

                    }

                }
                catch {

                    showMessage("خطا در ارتباط با سرور.", false);

                }
                finally {

                    button.disabled = false;

                }

            });

    </script>
}