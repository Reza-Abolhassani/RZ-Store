@model Entities.UserAddress

@{
    ViewData["Title"] = "ویرایش آدرس";
}

<div class="container mt-4 mb-5" dir="rtl"
     style="padding-top: 200px;">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">ویرایش آدرس</h5>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Profile"
                          asp-action="EditAddress"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">نام تحویل‌گیرنده</label>
                            <input asp-for="ReceiverName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">شماره موبایل</label>
                            <input asp-for="ReceiverPhone" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">استان</label>
                            <input asp-for="Province" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">شهر</label>
                            <input asp-for="City" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">آدرس کامل</label>
                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">کد پستی</label>
                            <input asp-for="PostalCode" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit" class="btn btn-primary">
                                ذخیره تغییرات
                            </button>

                            <a asp-controller="Profile"
                               asp-action="Addresses"
                               class="btn btn-secondary">
                                بازگشت
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>