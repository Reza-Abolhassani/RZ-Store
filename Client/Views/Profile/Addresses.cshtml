@model List<Entities.UserAddress>

@{
    ViewData["Title"] = "آدرس‌های من";
}

<div class="container mt-4 mb-5" dir="rtl"
     style="padding-top: 200px;">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4>آدرس‌های من</h4>

        <a asp-controller="Profile"
           asp-action="CreateAddress"
           class="btn btn-primary">
            <i class="fa fa-plus me-1"></i>
            افزودن آدرس جدید
        </a>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            هنوز هیچ آدرسی ثبت نکرده‌اید.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-3">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body">

                            <h5 class="mb-3">
                                @item.ReceiverName
                            </h5>

                            <p>
                                <strong>شماره تماس:</strong>
                                @item.ReceiverPhone
                            </p>

                            <p>
                                <strong>استان:</strong>
                                @item.Province
                            </p>

                            <p>
                                <strong>شهر:</strong>
                                @item.City
                            </p>

                            <p>
                                <strong>آدرس:</strong>
                                @item.Address
                            </p>

                            <p>
                                <strong>کد پستی:</strong>
                                @item.PostalCode
                            </p>

                            @if (item.IsDefault)
                            {
                                <span class="badge bg-success">
                                    آدرس پیش‌فرض
                                </span>
                            }

                            <div class="mt-3">

                                <a asp-controller="Profile"
                                   asp-action="EditAddress"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="fa fa-edit me-1"></i>
                                    ویرایش آدرس
                                </a>

                                <form asp-controller="Profile"
                                      asp-action="DeleteAddress"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('آیا از حذف این آدرس مطمئن هستید؟')">

                                        <i class="fa fa-trash me-1"></i>
                                        حذف آدرس

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>