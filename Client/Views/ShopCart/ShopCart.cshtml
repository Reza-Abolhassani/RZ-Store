@model Client.Dto.ShopCartDto

@{
    ViewData["Title"] = "سبد خرید";
}

<!-- Hero -->
<!-- Shopping Cart -->
<section class="section" style="padding-top: 150px;">
    <div class="container">

        <h4 class="mb-4" style="font-size: 21px;">سبد خرید</h4>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="row">

                <!-- Cart Products -->
                <div class="col-lg-8 col-md-7">

                    <div class="table-responsive bg-white shadow rounded">
                        <table class="table table-center table-padding mb-0">

                            <thead>
                                <tr>
                                    <th>حذف</th>
                                    <th>محصول</th>
                                    <th>قیمت</th>
                                    <th>تعداد</th>
                                    <th>مجموع</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.Items)
                                {
                                    <tr class="shop-list">

                                        <!-- حذف محصول و تصویر -->
                                        <td>
                                            <div class="d-flex align-items-center gap-3">

                                                <form asp-controller="ShopCart"
                                                      asp-action="Remove"
                                                      method="post"
                                                      class="me-2">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="Id" value="@item.Id" />

                                                    <button type="submit"
                                                            class="btn btn-link text-danger p-0"
                                                            title="حذف محصول">
                                                        <i class="uil uil-trash-alt"></i>
                                                    </button>

                                                </form>

                                                <img src="@item.ImageUrl"
                                                     class="img-fluid rounded"
                                                     style="width: 65px; height: 65px; object-fit: contain;"
                                                     alt="@item.ProductTitle" />

                                            </div>
                                        </td>

                                        <td>
                                            <h6 class="mb-0">@item.ProductTitle</h6>
                                        </td>

                                        <!-- قیمت محصول قبل و بعد از تخفیف -->
                                        <td>
                                            <div class="d-flex flex-column">

                                                @if (item.RawPrice > item.Price)
                                                {
                                                    <span class="text-muted text-decoration-line-through">
                                                        @item.RawPrice.ToString("N0") تومان
                                                    </span>
                                                }

                                                <strong class="text-success">
                                                    @item.Price.ToString("N0") تومان
                                                </strong>

                                            </div>
                                        </td>

                                        <!-- تعداد محصول -->
                                        <td>
                                            <form asp-controller="ShopCart"
                                                  asp-action="Update"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="Id" value="@item.Id" />

                                                <div class="quantity-control d-flex align-items-center">

                                                    <button type="button"
                                                            class="btn btn-light btn-sm"
                                                            onclick="changeCount(this, -1)">
                                                        −
                                                    </button>

                                                    <input type="number"
                                                           name="count"
                                                           value="@item.count"
                                                           min="1"
                                                           step="1"
                                                           required
                                                           class="form-control text-center mx-1"
                                                           style="width:60px" />

                                                    <button type="button"
                                                            class="btn btn-light btn-sm"
                                                            onclick="changeCount(this, 1)">
                                                        +
                                                    </button>

                                                </div>

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-primary mt-2">
                                                    بروزرسانی
                                                </button>

                                            </form>
                                        </td>

                                        <!-- مجموع قیمت -->
                                        <td>
                                            <strong>
                                                @item.TotalPrice.ToString("N0") تومان
                                            </strong>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>

                    

                </div>

                <!-- Cart Summary -->
                <div class="col-lg-4 col-md-5">

                    <div class="card border-0 rounded shadow">
                        <div class="card-body">

                            <h5 class="mb-3">خلاصه سبد خرید</h5>

                            <div class="d-flex justify-content-between mb-2">
                                <span>مجموع قیمت کالاها</span>
                                <span>@Model.TotalRawPrice.ToString("N0") تومان</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span>تخفیف</span>
                                <span class="text-success">
                                    @Model.DiscountPrice.ToString("N0") تومان
                                </span>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between mb-3">
                                <strong>مبلغ قابل پرداخت</strong>
                                <strong class="text-primary">
                                    @Model.TotalPrice.ToString("N0") تومان
                                </strong>
                            </div>

                            <a href="#" class="btn btn-primary w-100">
                                ادامه ثبت سفارش
                            </a>

                        </div>
                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                سبد خرید شما خالی است.
            </div>
        }

    </div>
</section>

<script>
    function changeCount(button, change) {
        var input = button.parentElement.querySelector('input[name="count"]');
        var value = parseInt(input.value) || 1;

        value += change;

        if (value < 1) {
            value = 1;
        }

        input.value = value;
    }
</script>