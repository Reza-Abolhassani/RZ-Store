@model Client.Dto.CheckoutDto

@{
    var selectedShipping = Model.ShippingTypes
        .FirstOrDefault(x => x.Id == Model.ShippingTypeId);

    var shippingPrice = selectedShipping?.Price ?? 0;

    var finalPrice = Model.ShopCart.TotalPrice + shippingPrice;
}






